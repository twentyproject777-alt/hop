; Exact 0.05 lot only when estimated SL loss fits 2% equity AND remaining risk limits.
; Start tester with deposit 500 USD. Test only, not a live recommendation.
InpAllowRealTrading=false
InpLotMode=1
InpFixedLots=0.05
InpRiskPercent=2.0
InpDailyLossPercent=3.0
InpWeeklyLossPercent=6.0
InpReduceRiskDrawdown=5.0
InpPauseDrawdown=8.0
InpHardDrawdown=10.0
InpMaxLots=0.10
InpMaxMarginPercent=20.0
InpRewardRisk=2.0
InpNewsMode=0
InpTesterSkipCalendar=true
InpDiagnostics=true
